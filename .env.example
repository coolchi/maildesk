APP_NAME=MailDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://maildesk.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared across apex + *.maildesk.test (bump cookie name when changing domain)
# PRODUCTION: Set SESSION_DOMAIN to your production domain with leading dot (e.g. .maildesk.ng)
# and update SANCTUM_STATEFUL_DOMAINS accordingly. Enable SESSION_SECURE_COOKIE=true for HTTPS.
SESSION_COOKIE=maildesk_session_v4
SESSION_DOMAIN=.maildesk.test
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=maildesk.test,*.maildesk.test

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Firebase Cloud Messaging legacy server key. When set, chat messages
# push to registered iOS and Android devices while the app is in the background.
FCM_SERVER_KEY=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MAILDESK_PROVIDER=resend
MAILDESK_BASE_DOMAIN=maildesk.test
MAILDESK_CENTRAL_DOMAINS=maildesk.test
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAILDESK_INBOUND_SECRET=

MAILDESK_SMTP_HOST=
MAILDESK_SMTP_PORT=587
MAILDESK_SMTP_USERNAME=
MAILDESK_SMTP_PASSWORD=
MAILDESK_SMTP_ENCRYPTION=tls
MAILDESK_API_RATE_LIMIT=120

# AI (OpenAI by default; Anthropic also supported). Platform admin can override
# provider/model/API key under /admin/settings. Fake provider is used in local/testing
# unless MAILDESK_AI_FAKE=false.
MAILDESK_AI_PROVIDER=openai
MAILDESK_AI_FAKE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Monipay payments (plan upgrades, NGN). Use pub_test_/pri_test_ keys in test mode.
# The private key never reaches the browser. Webhook URL to set in the Monipay
# dashboard: https://<your-app-host>/api/v1/payments/monipay/webhook
MONIPAY_PUBLIC_KEY=
MONIPAY_SECRET_KEY=
# Optional: HMAC secret for x-monipay-signature (defaults to MONIPAY_SECRET_KEY).
MONIPAY_WEBHOOK_SECRET=
# Naira per unit of plans.price when a plan has no explicit price_kobo (default 1).
MONIPAY_NAIRA_PER_PLAN_PRICE_UNIT=

# E2E Mail Test (php artisan maildesk:e2e)
# Verifies the complete send→MX→webhook→receive pipeline works in production.
# Requires RESEND_API_KEY and RESEND_WEBHOOK_SECRET to be set.
# IMPORTANT: Create a dedicated internal workspace for E2E tests (e.g., "MailDesk System")
# and set its ID here. Do not use a customer workspace.
MAILDESK_E2E_ORGANIZATION_ID=
MAILDESK_E2E_FROM=
MAILDESK_E2E_MAILBOX=e2e-check@maildesk.ng
MAILDESK_E2E_TIMEOUT=180
